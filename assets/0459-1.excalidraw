    {
      "id": "N5ILIWotEYQF3E2BYCwep",
      "type": "text",
      "x": 237.48114328911743,
      "y": 10.17663581756915,
      "width": 446.8399658203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
