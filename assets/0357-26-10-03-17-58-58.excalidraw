    },
    {
      "id": "0i4uUzyPv0xlN6jL5DkV6",
      "type": "text",
      "x": 430.25924649999996,
      "y": 424.53125,
      "width": 733.7799072265625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 704355618,
      "version": 339,
      "versionNonce": 1324452414,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791021872218,
      "link": null,
      "locked": false,
      "text": "槽 1：9 种，不能选 0，可以选 1～9\n槽 2：9 种，可选 0～9 中的数字（不能和槽 1 相同，1 个不能选，10-1）\n槽 3：8 种，可选 0～9 中的数字（不能和槽 1、2 相同，2 个不能选，10-2）\n槽 4：7 种，可选 0～9 中的数字（不能和槽 1、2、3 相同，3 个不能选，10-3）\n……",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "槽 1：9 种，不能选 0，可以选 1～9\n槽 2：9 种，可选 0～9 中的数字（不能和槽 1 相同，1 个不能选，10-1）\n槽 3：8 种，可选 0～9 中的数字（不能和槽 1、2 相同，2 个不能选，10-2）\n槽 4：7 种，可选 0～9 中的数字（不能和槽 1、2、3 相同，3 个不能选，10-3）\n……",
      "autoResize": true,
      "lineHeight": 1.25
    },
